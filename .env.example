# Copy to .env for local use. No secrets belong in Git.
# Plain KEY=VALUE only; no quotes, export, or inline comments in values.
# Existing process environment variables take precedence over .env.

# Default local demo needs no API key and uses SAM ViT-B on CPU.
MAGICLAYER_SAM_MODEL=vit_b

# Online option A: OpenAI-compatible vision + image-generation endpoint.
# Use real model IDs supplied by your service; no model names are guessed.
# MAGICLAYER_API_STYLE=openai
# MAGICLAYER_OPENAI_BASE=https://your-gateway.example/v1
# OPENAI_API_KEY=
# MAGICLAYER_PLANNER_MODEL=
# MAGICLAYER_IMAGE_MODEL=

# Online option B: Gemini native endpoint (do not set the OpenAI base for this).
# MAGICLAYER_API_STYLE=gemini
# MAGICLAYER_GEMINI_BASE=https://generativelanguage.googleapis.com
# GEMINI_API_KEY=
# MAGICLAYER_PLANNER_MODEL=
# MAGICLAYER_IMAGE_MODEL=

# Per-stage OpenAI-compatible endpoints override the global endpoint.
# PLANNER uses /chat/completions; ELEMENT/BACKGROUND use /images/edits.
# MAGICLAYER_PLANNER_BASE=https://your-gateway.example/v1
# MAGICLAYER_PLANNER_KEY=
# MAGICLAYER_PLANNER_MODEL=
# MAGICLAYER_ELEMENT_BASE=https://your-gateway.example/v1
# MAGICLAYER_ELEMENT_KEY=
# MAGICLAYER_ELEMENT_MODEL=
# MAGICLAYER_BACKGROUND_BASE=https://your-gateway.example/v1
# MAGICLAYER_BACKGROUND_KEY=
# MAGICLAYER_BACKGROUND_MODEL=
# MAGICLAYER_ELEMENT_QUALITY=high
# MAGICLAYER_BACKGROUND_QUALITY=high

# Optional network settings. Proxy credentials belong only in this ignored file.
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1
# MAGICLAYER_IMAGE_URL_PROXY=http://127.0.0.1:7890
